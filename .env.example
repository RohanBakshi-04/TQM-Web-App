# ==============================================================================
# Hostel Management System (HMS) — Environment Configuration Template
# Course: BBAT104 - Fundamentals of Total Quality Management (TQM)
# Quality Goal: Q05 - Reduce Response Time (< 10ms SLA)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit .env to version control):
#    cp .env.example .env
# 2. For local development/testing, default development values will suffice.
# 3. For PRODUCTION deployments:
#    - Set APP_ENV="production"
#    - Set DEBUG=False
#    - Generate two independent cryptographically secure keys (>= 32 chars):
#        python -c "import secrets; print(secrets.token_hex(32))"
#    - Set SECRET_KEY and JWT_SECRET_KEY below with the generated keys.
# ==============================================================================

# Application Settings
APP_NAME="Hostel Management System Web App"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Cryptographic Session Signing)
# IN PRODUCTION: Replace these placeholders with distinct cryptographically random keys.
# Startup validation strictly rejects default placeholders and keys < 32 characters.
SECRET_KEY="replace-this-in-production-with-a-secure-random-key-min-32-chars"
JWT_SECRET_KEY="replace-this-in-production-with-a-secure-random-key-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_PATH="data/hostel_web.db"
ENABLE_SQLITE_WAL=True

# Demonstration Data Seeding
# 'auto': seeds demo accounts in development/test, disabled in production
# Explicit options: True (dev only) or False (recommended for production)
ENABLE_DEMO_SEEDING="auto"

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
