# Application Settings
APP_NAME="Hostel Management System Web App"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Cryptographic Sessions)
SECRET_KEY="replace-this-in-production-with-a-secure-random-key"
JWT_SECRET_KEY="replace-this-in-production-with-a-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_PATH="data/hostel_web.db"
ENABLE_SQLITE_WAL=True
ENABLE_DEMO_SEEDING=True

# CORS Configuration
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
